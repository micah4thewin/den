{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Play",
  "version": "0.1.0",
  "identifier": "dev.play.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && npm run bundle:runtime"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Play",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; script-src 'self'; worker-src blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "nsis",
      "msi",
      "app",
      "dmg"
    ],
    "category": "Game",
    "shortDescription": "A quiet place to play the games you already own",
    "longDescription": "Play is a local-first launcher that sorts, repairs, and shelves your game files, boots them through RetroArch, and resumes where you left off.",
    "copyright": "Play contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "resources": {
      "resources/runtime": "runtime"
    },
    "linux": {
      "deb": {
        "recommends": [
          "retroarch",
          "libretro-nestopia",
          "libretro-snes9x",
          "libretro-genesisplusgx",
          "libretro-gambatte",
          "libretro-mgba",
          "libretro-beetle-psx"
        ]
      }
    }
  }
}
